{
  "name": "@itm/desktop",
  "productName": "iTerminal",
  "version": "1.2.0",
  "private": true,
  "description": "iTerminal Desktop",
  "author": "Lucas",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-app-name.mjs && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-vitest.mjs run",
    "e2e": "electron-vite build && playwright test",
    "postinstall": "node scripts/fix-node-pty.mjs && electron-builder install-app-deps && node scripts/dev-app-name.mjs",
    "dist:dir": "electron-vite build && electron-builder --dir -c.mac.identity=- -c.electronDist=../../node_modules/electron/dist",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:win:cross": "electron-vite build && electron-builder --win nsis --x64 -c electron-builder.win-cross.yml",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:e2e": "electron-vite build && electron-builder --dir -c.mac.identity=- -c.electronDist=../../node_modules/electron/dist -c.electronFuses.enableNodeCliInspectArguments=true -c.directories.output=release/e2e"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@anthropic-ai/sdk": "^0.129.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@itm/agent-core": "workspace:*",
    "@itm/approval": "workspace:*",
    "@itm/masking": "workspace:*",
    "@itm/protocol": "workspace:*",
    "@itm/sync-merge": "workspace:*",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.63.0",
    "@scure/bip39": "^2.4.0",
    "@types/node": "^24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.6.5",
    "codemirror": "6.0.2",
    "dayjs": "1.11.23",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "hash-wasm": "^4.12.0",
    "openai": "^7.25.0",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "15.9.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "^5.0.2",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/js-yaml": "^4.0.9",
    "basic-ftp": "^5.3.1",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.3",
    "js-yaml": "^5.4.3",
    "mammoth": "^1.13.0",
    "mysql2": "3.24.6",
    "node-pty": "1.1.0",
    "pg": "8.23.1",
    "serialport": "13.0.0",
    "ssh2": "1.17.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "word-extractor": "^1.0.4",
    "zod": "4.6.7"
  }
}
