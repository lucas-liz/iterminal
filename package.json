{
  "name": "iterminal",
  "private": true,
  "description": "iTerminal 客户端 Monorepo（桌面端 + 管理后台）",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @itm/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @itm/desktop e2e",
    "dist:mac": "pnpm --filter @itm/desktop dist:mac",
    "dist:win": "pnpm --filter @itm/desktop dist:win",
    "dist:linux": "pnpm --filter @itm/desktop dist:linux"
  }
}
