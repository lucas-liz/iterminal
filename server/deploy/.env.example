# 复制为 .env 后修改。不要把 .env 提交到代码仓库。

# MySQL root 密码（只在容器里用）
MYSQL_ROOT_PASSWORD=请换成随机密码
# 后端连接数据库的 itm 账号密码
DB_PASSWORD=请换成随机密码
# JWT 签名密钥：openssl rand -hex 32
TOKEN_SECRET=请换成随机密钥
# 加密团队模型 API Key、团队主机密码的密钥：openssl rand -hex 32（设置后不要再改，换了之后已保存的密文解不开）
ITM_DATA_KEY=请换成随机密钥
# Druid 监控页的登录密码
DRUID_PASSWORD=请换成随机密码

# 对外端口（管理后台和客户端都从这里访问；客户端的服务端地址填 http://服务器地址:端口/prod-api）
HTTP_PORT=80
# 单个上传文件上限（客户端安装包）
ITM_MAX_UPLOAD=1GB
# 后端 JVM 参数
JAVA_OPTS=-Xms512m -Xmx1g

# 邮件通知（可选，通知渠道「邮件」用）：465 端口用 SSL；587 端口改成 ITM_SMTP_SSL=false、ITM_SMTP_STARTTLS=true
# ITM_SMTP_HOST=smtp.example.com
# ITM_SMTP_PORT=465
# ITM_SMTP_USER=iterminal@example.com
# ITM_SMTP_PASSWORD=邮箱密码或授权码
# ITM_SMTP_FROM=iterminal@example.com

# 构建加速（可选）：国内网络可以用镜像
# MAVEN_MIRROR=https://maven.aliyun.com/repository/public
# NPM_REGISTRY=https://registry.npmmirror.com
