<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iterminal.mapper.ItmMaskRuleMapper">

    <resultMap type="ItmMaskRule" id="ItmMaskRuleResult">
        <id     property="ruleId" column="rule_id" />
        <result property="ruleName" column="rule_name" />
        <result property="pattern" column="pattern" />
        <result property="replacement" column="replacement" />
        <result property="forcePrivate" column="force_private" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>
    <sql id="selectItmMaskRule">select rule_id, rule_name, pattern, replacement, force_private, status, create_by, create_time, update_by, update_time from itm_mask_rule</sql>

    <select id="selectItmMaskRuleById" parameterType="Long" resultMap="ItmMaskRuleResult">
        <include refid="selectItmMaskRule"/> where rule_id = #{ruleId}
    </select>

    <select id="selectItmMaskRuleList" parameterType="ItmMaskRule" resultMap="ItmMaskRuleResult">
        <include refid="selectItmMaskRule"/>
        <where>
            <if test="ruleName != null and ruleName != ''">and rule_name like concat('%', #{ruleName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by rule_id
    </select>

    <insert id="insertItmMaskRule" parameterType="ItmMaskRule" useGeneratedKeys="true" keyProperty="ruleId">
        insert into itm_mask_rule (rule_name, pattern, replacement, force_private, status, create_by, create_time)
        values (#{ruleName}, #{pattern}, #{replacement}, #{forcePrivate}, #{status}, #{createBy}, sysdate())
    </insert>

    <update id="updateItmMaskRule" parameterType="ItmMaskRule">
        update itm_mask_rule
        <trim prefix="SET" suffixOverrides=",">
            <if test="ruleName != null">rule_name = #{ruleName},</if>
            <if test="pattern != null">pattern = #{pattern},</if>
            <if test="replacement != null">replacement = #{replacement},</if>
            <if test="forcePrivate != null">force_private = #{forcePrivate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where rule_id = #{ruleId}
    </update>

    <delete id="deleteItmMaskRuleByIds" parameterType="Long">
        delete from itm_mask_rule where rule_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>

</mapper>
