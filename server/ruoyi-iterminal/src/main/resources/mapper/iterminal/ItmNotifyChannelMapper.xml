<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iterminal.mapper.ItmNotifyChannelMapper">

    <resultMap type="ItmNotifyChannel" id="ItmNotifyChannelResult">
        <id     property="channelId" column="channel_id" />
        <result property="channelName" column="channel_name" />
        <result property="channelType" column="channel_type" />
        <result property="webhook" column="webhook" />
        <result property="secret" column="secret" />
        <result property="recipients" column="recipients" />
        <result property="mention" column="mention" />
        <result property="events" column="events" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>
    <sql id="selectItmNotifyChannel">select channel_id, channel_name, channel_type, webhook, secret, recipients, mention, events, status, create_by, create_time, update_by, update_time, remark from itm_notify_channel</sql>

    <select id="selectItmNotifyChannelById" parameterType="Long" resultMap="ItmNotifyChannelResult">
        <include refid="selectItmNotifyChannel"/> where channel_id = #{channelId}
    </select>

    <select id="selectItmNotifyChannelList" parameterType="ItmNotifyChannel" resultMap="ItmNotifyChannelResult">
        <include refid="selectItmNotifyChannel"/>
        <where>
            <if test="channelName != null and channelName != ''">and channel_name like concat('%', #{channelName}, '%')</if>
            <if test="channelType != null and channelType != ''">and channel_type = #{channelType}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by channel_id
    </select>

    <select id="selectSubscribers" parameterType="String" resultMap="ItmNotifyChannelResult">
        <include refid="selectItmNotifyChannel"/> where status = '0' and find_in_set(#{event}, events) > 0
    </select>

    <insert id="insertItmNotifyChannel" parameterType="ItmNotifyChannel" useGeneratedKeys="true" keyProperty="channelId">
        insert into itm_notify_channel (channel_name, channel_type, webhook, secret, recipients, mention, events, status, create_by, create_time, remark)
        values (#{channelName}, #{channelType}, ifnull(#{webhook}, ''), ifnull(#{secret}, ''), ifnull(#{recipients}, ''), ifnull(#{mention}, ''), #{events}, ifnull(#{status}, '0'), ifnull(#{createBy}, ''), sysdate(), ifnull(#{remark}, ''))
    </insert>

    <update id="updateItmNotifyChannel" parameterType="ItmNotifyChannel">
        update itm_notify_channel
        <set>
            <if test="channelName != null">channel_name = #{channelName},</if>
            <if test="channelType != null">channel_type = #{channelType},</if>
            <if test="webhook != null">webhook = #{webhook},</if>
            <if test="secret != null">secret = #{secret},</if>
            <if test="recipients != null">recipients = #{recipients},</if>
            <if test="mention != null">mention = #{mention},</if>
            <if test="events != null">events = #{events},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where channel_id = #{channelId}
    </update>

    <delete id="deleteItmNotifyChannelByIds" parameterType="Long">
        delete from itm_notify_channel where channel_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
